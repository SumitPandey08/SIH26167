# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Next.js Build
frontend/.next/
frontend/out/

# Node Backend Build
backend/dist/
backend/storage

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Large Raw Datasets (Keep real benchmark samples, ignore multi-GB raw dumps)
datasets/raw/*
!datasets/raw/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Storage Generated Artifacts
storage/masks/*
!storage/masks/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
storage/checkpoints/*
!storage/checkpoints/.gitkeep
